# Terraform on Azure - Comprehensive .gitignore

# Terraform Files
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*
.terraform/
.terraform.lock.hcl
terraform.tfvars
terraform.tfvars.json

# Sensitive Variable Files
*.auto.tfvars
*.auto.tfvars.json
secrets.tfvars
production.tfvars

# Crash Log Files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
# Exception: *.tfvars.example files are kept for documentation
*.tfvars
!*.tfvars.example

# Ignore override files as they are usually used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Ignore CLI configuration files
.terraformrc
terraform.rc

# IDE and Editor Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# OS Generated Files
.DS_Store?
ehthumbs.db
Icon?

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# Dependency directories
node_modules/
.npm

# Optional npm cache directory
.npm

# Temporary folders
tmp/
temp/
.tmp/

# Azure CLI
.azure/

# TFLint
.tflint.d/

# Checkov
.checkov.baseline

# Test directories and files (if using terratest)
test/.terraform/
test/*.tfstate
test/*.tfstate.*
test/*.tfplan
test/*.tfplan.*
test/vendor/

# Generated documentation
docs/generated/

# Backup files
*.bak
*.backup

# Environment specific files
.env
.env.local
.env.*.local

# Local development
local/
.local/

# Archives
*.zip
*.tar.gz
*.rar

# Python (if using python tools)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Go (if using terratest or other go tools)
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
vendor/

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Go workspace file
go.work

# Kubernetes
kubeconfig
*.kubeconfig

# Helm
*.tgz

# JetBrains IDEs
.idea/
*.iml
*.iws
*.ipr

# Visual Studio Code
.vscode/
!.vscode/settings.json.example
!.vscode/extensions.json.example

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
Session.vim

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# SSH Keys (should never be committed)
*.pem
*.key
id_rsa
id_dsa
id_ecdsa
id_ed25519

# Certificate files
*.crt
*.cer
*.p12
*.pfx

# Docker
Dockerfile.local
docker-compose.override.yml
.dockerignore.local

# Azure Storage Explorer
StorageExplorer/

# Azure Functions
local.settings.json
bin/
obj/

# Terraform Cloud/Enterprise
.terraform.d/
.terraform-version

# Ansible
*.retry

# Packer
packer_cache/
*.box

# Local state backup files (if you use them)
terraform.tfstate.backup.*